# ==============================================================================
# MedVision AI — Environment Configuration Template
# Copy to .env and fill in secure local values. Never commit real secrets.
# ==============================================================================

# Optional: Gemini API key strictly for the non-diagnostic educational technical explainer.
# Never used for medical image diagnosis or clinical inference.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL (injected automatically in cloud preview environments)
APP_URL="http://localhost:3000"

# Frontend -> FastAPI proxy URL (set to http://backend:8000 in Docker Compose)
FASTAPI_BACKEND_URL=""

# PostgreSQL credentials (used by Docker Compose and FastAPI SQLAlchemy)
POSTGRES_USER="medvision"
POSTGRES_PASSWORD="change_me_postgres_password"
POSTGRES_DB="medvision_pacs"

# Orthanc DICOM Server credentials (bound to 127.0.0.1 only, never publicly exposed)
ORTHANC_PASSWORD="change_me_orthanc_password"

# FastAPI Security & CORS
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
REQUIRE_AUTH="false"
API_AUTH_TOKEN="change_me_radiologist_api_token"
DEVICE="auto"
