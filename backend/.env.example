# MedVision AI FastAPI Backend Environment Configuration
# Copy to .env and replace placeholder values before deployment.

APP_ENV=development
DATABASE_URL=postgresql+psycopg2://medvision:change_me_postgres_password@postgres:5432/medvision_pacs

# Orthanc PACS internal Docker network coordinates (never expose Orthanc admin publicly)
ORTHANC_URL=http://orthanc:8042
ORTHANC_USERNAME=orthanc_admin
ORTHANC_PASSWORD=change_me_orthanc_password

# Storage paths (stored on disk/volumes outside PostgreSQL)
STORAGE_DIR=/app/storage
MODELS_DIR=/app/models
REPORTS_DIR=/app/reports
MAX_UPLOAD_MB=50

# CORS & Security
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUIRE_AUTH=false
API_AUTH_TOKEN=change_me_radiologist_api_token

# Trained checkpoint paths (mounted via Docker volume)
CXR_WEIGHTS_PATH=/app/models/densenet121_nih14.pth
SEG_WEIGHTS_PATH=/app/models/monai_unet3d_task06_lung.pth
DEVICE=auto
